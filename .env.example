# MongoDB connection string (MongoDB Atlas for development, see docs/development.md)
NUXT_MONGODB_URI=

# Read the client IP from X-Forwarded-For. Only behind a proxy that overwrites it (Vercel). Default false.
# NUXT_TRUST_PROXY=true

# Session encryption key for nuxt-auth-utils, at least 32 characters.
# Generated automatically in development if left empty.
NUXT_SESSION_PASSWORD=

# End-to-end tests (ADR-007). Optional: tests that write data are skipped without these.
# Use a separate database (e.g. same cluster, database name 707_e2e).
E2E_MONGODB_URI=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=

# Client demo (docs/demo/demo-script.md). The database name must end in "_demo".
DEMO_MONGODB_URI=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
